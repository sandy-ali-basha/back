<?php
namespace App\Http\Patterns;;

use $MODEL_PATH;
use App\Models\Logs;
use App\Models\$MODEL_NAMEModel;
use Illuminate\Support\Facades\Log;

class Delete$MODEL_NAME implements IOperations
{
    public function doOperation(array $data)
    {
        $$SERVICE_NAME = $MODEL_NAME::find($data['id']);
        $$SERVICE_NAME->deleteTranslations();
        return $$SERVICE_NAME->delete();
    }

    public function audit()
    {
        Logs::createNewRecord('delete', '$MODEL_NAME');
    }

